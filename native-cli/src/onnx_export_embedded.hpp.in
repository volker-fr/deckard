#pragma once
// Generated by CMake with the repository's onnx/export.py and onnx/export/Dockerfile
// embedded verbatim, so deckard install can regenerate model.onnx automatically
// inside a pinned container image without any external file or package.
namespace aihider {
inline constexpr const char* onnx_export_py = R"deckard_py(@ONNX_EXPORT_PY@)deckard_py";
inline constexpr const char* onnx_export_dockerfile = R"deckard_docker(@ONNX_EXPORT_DOCKERFILE@)deckard_docker";
}